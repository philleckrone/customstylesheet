<Window x:Class="CustomStyEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CustomStyEditor"
        Title="Custom Stylesheet Editor"
        Height="800" Width="1180"
        MinHeight="480" MinWidth="820"
        Closing="Window_Closing">

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New"
                        Executed="New_Executed"
                        CanExecute="Always_CanExecute"/>
        <CommandBinding Command="ApplicationCommands.Open"
                        Executed="Open_Executed"
                        CanExecute="Always_CanExecute"/>
        <CommandBinding Command="ApplicationCommands.Save"
                        Executed="Save_Executed"
                        CanExecute="Always_CanExecute"/>
        <CommandBinding Command="{x:Static local:MainWindow.SaveAsCommand}"
                        Executed="SaveAs_Executed"
                        CanExecute="Always_CanExecute"/>
    </Window.CommandBindings>

    <DockPanel>

        <!-- Menu bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{DynamicResource Menu_File}">
                <MenuItem Header="{DynamicResource Menu_New}"    Command="ApplicationCommands.New"/>
                <MenuItem Header="{DynamicResource Menu_Open}"   Command="ApplicationCommands.Open"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Menu_Save}"   Command="ApplicationCommands.Save"/>
                <MenuItem Header="{DynamicResource Menu_SaveAs}" Command="{x:Static local:MainWindow.SaveAsCommand}"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Menu_Exit}" Click="Exit_Click"/>
            </MenuItem>
        </Menu>

        <!-- Project identity bar -->
        <Border DockPanel.Dock="Top"
                Background="#E8EEF7"
                BorderBrush="#C3D2E8"
                BorderThickness="0,0,0,1"
                Padding="10,6">
            <StackPanel>
                <TextBlock x:Name="ProjectHeaderText"
                           FontWeight="SemiBold"
                           FontSize="14"/>
                <TextBlock x:Name="BaseSheetText"
                           Margin="0,2,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Reminder banner -->
        <Border DockPanel.Dock="Top"
                Background="#FFF3CD"
                BorderBrush="#FFEAA0"
                BorderThickness="0,0,0,1"
                Padding="10,4">
            <TextBlock Text="{DynamicResource Banner_Reminder}"
                       FontStyle="Italic"
                       TextWrapping="Wrap"
                       Foreground="#856404"/>
        </Border>

        <!-- Language toolbar -->
        <Border DockPanel.Dock="Top"
                Background="#F5F5F5"
                BorderBrush="#D0D0D0"
                BorderThickness="0,0,0,1"
                Padding="8,4">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Toolbar_Language}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="LanguageCombo"
                          Width="130"
                          SelectionChanged="LanguageCombo_SelectionChanged"/>
            </WrapPanel>
        </Border>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="#F0F0F0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText"/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" MinWidth="280"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="380"/>
            </Grid.ColumnDefinitions>

            <!-- Left: markers in custom.sty -->
            <Grid Grid.Column="0" Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="MarkerGrid"
                          Grid.Row="0"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserSortColumns="False"
                          CanUserReorderColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E0E0E0"
                          AlternatingRowBackground="#FAFAFA"
                          SelectionChanged="MarkerGrid_SelectionChanged"
                          PreviewKeyDown="MarkerGrid_PreviewKeyDown">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="ToolTip" Value="{Binding Warning}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Warning}" Value="">
                                    <Setter Property="ToolTip" Value="{x:Null}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                    <Setter Property="Foreground" Value="#888888"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRemoved}" Value="True">
                                    <Setter Property="Foreground" Value="#A04040"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding DisplayMarker}" Width="70" FontFamily="Consolas"/>
                        <DataGridTextColumn Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Binding="{Binding Changes}" Width="*"/>
                        <DataGridTextColumn Binding="{Binding Status}" Width="Auto"/>
                        <!-- Last column, so it is not mistaken for a "select this row" box: ticking it comments the entry out. -->
                        <DataGridTemplateColumn Width="Auto" MinWidth="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsDisabled, Mode=OneWay}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ToolTip="{DynamicResource Tip_DisabledColumn}"
                                              Click="DisabledCheck_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <WrapPanel Grid.Row="1" Margin="0,6,0,0">
                    <Button x:Name="AddStockButton" Content="{DynamicResource Btn_AddStock}"
                            ToolTip="{DynamicResource Tip_AddStock}"
                            Padding="8,3" Margin="0,0,6,4" Click="AddStock_Click"/>
                    <Button x:Name="NewMarkerButton" Content="{DynamicResource Btn_NewMarker}"
                            ToolTip="{DynamicResource Tip_NewMarker}"
                            Padding="8,3" Margin="0,0,6,4" Click="NewMarker_Click"/>
                    <Button x:Name="RemoveButton" Content="{DynamicResource Btn_Remove}"
                            ToolTip="{DynamicResource Tip_Remove}"
                            Padding="8,3" Margin="0,0,6,4" Click="Remove_Click"/>
                    <Button x:Name="DeleteButton" Content="{DynamicResource Btn_Delete}"
                            ToolTip="{DynamicResource Tip_Delete}"
                            Padding="8,3" Margin="0,0,6,4" Click="Delete_Click"/>
                </WrapPanel>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#E4E4E4"/>

            <!-- Right: properties of the selected marker -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="160"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="200" MinHeight="90"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PropertyPanel" Margin="10,8,14,8">
                        <TextBlock x:Name="PanelHeader" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="PanelNote" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#555555"/>
                        <TextBlock x:Name="PanelWarnings" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#B00020"/>
                        <StackPanel x:Name="GroupsPanel" Margin="0,6,0,0"/>
                    </StackPanel>
                </ScrollViewer>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#E4E4E4"/>

                <Grid Grid.Row="2" Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Preview_Title}" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <Border BorderBrush="#C8C8C8" BorderThickness="1" Background="White">
                            <FlowDocumentScrollViewer x:Name="PreviewViewer"
                                                      VerticalScrollBarVisibility="Auto"
                                                      IsToolBarVisible="False"
                                                      Focusable="False"/>
                        </Border>
                    </DockPanel>
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource FileText_Title}" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="FileTextBox"
                                 IsReadOnly="True"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 Background="#FBFBFB"/>
                    </DockPanel>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
