    <sys:String x:Key="Picker_InFile">(no custom.sty)</sys:String>
    <sys:String x:Key="Picker_NoBase">A folha de estilos base não foi encontrada, então não há lista de marcadores padrão.</sys:String>
    <sys:String x:Key="New_Title">Novo marcador</sys:String>
    <sys:String x:Key="New_Marker">Marcador (sem \):</sys:String>
    <sys:String x:Key="New_Name">Nome:</sys:String>
    <sys:String x:Key="New_StyleType">Tipo de estilo:</sys:String>
    <sys:String x:Key="New_Endmarker">Marcador final:</sys:String>
    <sys:String x:Key="New_TextType">Tipo de texto:</sys:String>
