<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Menu -->
    <sys:String x:Key="Menu_File">_Arquivo</sys:String>
    <sys:String x:Key="Menu_New">_Novo</sys:String>
    <sys:String x:Key="Menu_Open">_Abrir…</sys:String>
    <sys:String x:Key="Menu_Save">_Salvar</sys:String>
    <sys:String x:Key="Menu_SaveAs">Salvar _como…</sys:String>
    <sys:String x:Key="Menu_Exit">Sa_ir</sys:String>

    <!-- Toolbar / project bar / banner -->
    <sys:String x:Key="Toolbar_Language">Idioma:</sys:String>
    <sys:String x:Key="ProjectBar_Format">Projeto: {0}</sys:String>
    <sys:String x:Key="ProjectBar_Base">Folha de estilos base: {0}</sys:String>
    <sys:String x:Key="ProjectBar_BaseMissing">A folha de estilos base {0} não foi encontrada; os valores padrão e a lista de marcadores não estão disponíveis.</sys:String>
    <sys:String x:Key="Banner_Reminder">O Paratext só lê o custom.sty ao iniciar: depois de salvar, feche o Paratext e abra-o novamente para ver as alterações.</sys:String>

    <!-- Marker list -->
    <sys:String x:Key="Column_Disabled">Desat.</sys:String>
    <sys:String x:Key="Column_Marker">Marcador</sys:String>
    <sys:String x:Key="Column_Name">Nome</sys:String>
    <sys:String x:Key="Column_Changes">Alterações</sys:String>
    <sys:String x:Key="Column_Status">Estado</sys:String>
    <sys:String x:Key="Tip_DisabledColumn">Marcado: toda a entrada está comentada com #, então o Paratext a ignora.</sys:String>
    <sys:String x:Key="Btn_AddStock">Adicionar marcador padrão…</sys:String>
    <sys:String x:Key="Btn_NewMarker">Novo marcador…</sys:String>
    <sys:String x:Key="Btn_Remove">Remover da folha de estilos</sys:String>
    <sys:String x:Key="Btn_Restore">Restaurar marcador</sys:String>
    <sys:String x:Key="Btn_Delete">Excluir</sys:String>
    <sys:String x:Key="Tip_AddStock">Personalizar um marcador da folha de estilos base.</sys:String>
    <sys:String x:Key="Tip_NewMarker">Definir um marcador que a folha de estilos base não tem. Ele é adicionado no fim do custom.sty.</sys:String>
    <sys:String x:Key="Tip_Remove">Escreve \Marker nome - para que o Paratext não ofereça mais o marcador.</sys:String>
    <sys:String x:Key="Tip_Delete">Exclui todas as linhas desta entrada do custom.sty; o marcador volta ao estilo padrão.</sys:String>
    <sys:String x:Key="Status_New">novo</sys:String>
    <sys:String x:Key="Status_Removed">removido</sys:String>
    <sys:String x:Key="Status_Disabled">comentado</sys:String>
    <sys:String x:Key="Status_Warning">⚠ verificar</sys:String>

    <!-- Property panel -->
    <sys:String x:Key="Panel_Empty">Selecione um marcador à esquerda ou adicione um com os botões abaixo da lista.</sys:String>
    <sys:String x:Key="Panel_DisabledNote">Esta entrada está comentada (#), então o Paratext a ignora. Desmarque Desat. na lista para editá-la.</sys:String>
    <sys:String x:Key="Panel_RemovedNote">\Marker {0} - remove este marcador da folha de estilos do projeto. Escolha Restaurar marcador para usá-lo novamente.</sys:String>
    <sys:String x:Key="Panel_NewNote">\{0} não está na folha de estilos base: é um marcador novo.</sys:String>
    <sys:String x:Key="Group_Identity">Nome e tipo</sys:String>
    <sys:String x:Key="Group_TextFormat">Formato do texto</sys:String>
    <sys:String x:Key="Group_Font">Fonte e cor</sys:String>
    <sys:String x:Key="Group_Paragraph">Parágrafo</sys:String>
    <sys:String x:Key="Group_Placement">Onde pode ocorrer</sys:String>
    <sys:String x:Key="Group_Other">Outros</sys:String>
    <sys:String x:Key="Group_OtherLines">Outras linhas desta entrada</sys:String>
    <sys:String x:Key="Tip_LineEnabled">Marcado: o Paratext usa esta linha. Desmarcado: a linha está comentada com #.</sys:String>
    <sys:String x:Key="Tip_Clear">Remover esta linha do custom.sty (o valor padrão volta a valer).</sys:String>
    <sys:String x:Key="Row_Stock">{0}: {1}</sys:String>
    <sys:String x:Key="Row_NotSet">(não definido)</sys:String>
    <sys:String x:Key="Row_Overridden">Também definido na linha {0}. O Paratext usa a última linha e informa uma duplicata.</sys:String>
    <sys:String x:Key="Flag_NotSet">(não definido)</sys:String>
    <sys:String x:Key="Flag_On">Sim</sys:String>
    <sys:String x:Key="Flag_Off">Não (\{0} -)</sys:String>
    <sys:String x:Key="Flag_StockOn">sim</sys:String>
    <sys:String x:Key="Flag_StockOff">não</sys:String>
    <sys:String x:Key="Color_Pick">Escolher cor…</sys:String>
    <sys:String x:Key="Color_NamesLabel">Nome de cor do Paratext:</sys:String>
    <sys:String x:Key="Color_UnknownName">(nome de cor desconhecido)</sys:String>
    <sys:String x:Key="Btn_Choose">Escolher…</sys:String>
    <sys:String x:Key="Unit_Points">pt</sys:String>
    <sys:String x:Key="Unit_Inches">polegadas</sys:String>
    <sys:String x:Key="Unit_LineSpacing">0 = simples, 1 = 1½, 2 = duplo</sys:String>
    <sys:String x:Key="Note_TextProperties">O Paratext acrescenta estas palavras às propriedades de texto da folha de estilos base; o custom.sty não pode remover nenhuma.</sys:String>

    <!-- Keyword tooltips (from the Paratext help) -->
    <sys:String x:Key="KwTip_Name">O nome mostrado na lista de marcadores. Deve ser único; edite-o para traduzir os nomes dos marcadores.</sys:String>
    <sys:String x:Key="KwTip_Description">Um comentário que descreve o marcador. "(basic)" no fim o inclui entre os marcadores básicos.</sys:String>
    <sys:String x:Key="KwTip_StyleType">Paragraph (parágrafo), Character (caractere), Note (nota) ou Milestone (marco).</sys:String>
    <sys:String x:Key="KwTip_Endmarker">O marcador final, se houver (por exemplo f*).</sys:String>
    <sys:String x:Key="KwTip_TextType">O tipo de texto: VerseText, Title, Section, NoteText, Other, BackTranslation...</sys:String>
    <sys:String x:Key="KwTip_TextProperties">Propriedades como paragraph, publishable, vernacular, poetic, level_1.</sys:String>
    <sys:String x:Key="KwTip_Bold">O texto fica em negrito.</sys:String>
    <sys:String x:Key="KwTip_Italic">O texto fica em itálico.</sys:String>
    <sys:String x:Key="KwTip_Underline">O texto fica sublinhado.</sys:String>
    <sys:String x:Key="KwTip_Smallcaps">O texto é mostrado em versaletes.</sys:String>
    <sys:String x:Key="KwTip_Superscript">O texto fica elevado.</sys:String>
    <sys:String x:Key="KwTip_Subscript">O texto fica rebaixado.</sys:String>
    <sys:String x:Key="KwTip_Regular">Desativa o negrito, o itálico e o sobrescrito.</sys:String>
    <sys:String x:Key="KwTip_Fontname">Fonte deste marcador. Sem ela, usa-se a fonte do projeto.</sys:String>
    <sys:String x:Key="KwTip_FontSize">Tamanho da fonte em pontos, relativo a 12 (o tamanho de fonte do projeto o desloca).</sys:String>
    <sys:String x:Key="KwTip_Color">Cor do texto: um nome de cor do Paratext (bom para baixa visão ou daltonismo) ou uma cor exata.</sys:String>
    <sys:String x:Key="KwTip_Justification">Left (esquerda), Center (centro), Right (direita) ou Both (justificado).</sys:String>
    <sys:String x:Key="KwTip_LeftMargin">Recuo do parágrafo inteiro, em polegadas.</sys:String>
    <sys:String x:Key="KwTip_RightMargin">Recuo direito do parágrafo, em polegadas.</sys:String>
    <sys:String x:Key="KwTip_FirstLineIndent">Recuo adicional da primeira linha, em polegadas (negativo para um recuo deslocado).</sys:String>
    <sys:String x:Key="KwTip_SpaceBefore">Espaço adicional antes do parágrafo, em pontos.</sys:String>
    <sys:String x:Key="KwTip_SpaceAfter">Espaço adicional depois do parágrafo, em pontos.</sys:String>
    <sys:String x:Key="KwTip_LineSpacing">Espaço adicional entre as linhas: 0 = simples, 1 = um e meio, 2 = duplo.</sys:String>
    <sys:String x:Key="KwTip_OccursUnder">Marcadores sob os quais este marcador pode ocorrer, separados por espaços. NEST permite aninhar um estilo de caractere em outro.</sys:String>
    <sys:String x:Key="KwTip_Rank">Com OccursUnder, a ordem dos marcadores sob o mesmo marcador superior.</sys:String>
    <sys:String x:Key="KwTip_NotRepeatable">O marcador não deve ser repetido sob o marcador superior.</sys:String>
    <sys:String x:Key="KwTip_Attributes">Atributos USFM 3 aceitos pelo marcador (? = opcional).</sys:String>

    <!-- Preview / file text -->
    <sys:String x:Key="Preview_Title">Pré-visualização (aproximada)</sys:String>
    <sys:String x:Key="FileText_Title">Linhas no custom.sty</sys:String>
    <sys:String x:Key="Preview_Sample">No princípio, Deus criou os céus e a terra. A terra era sem forma e vazia, e havia trevas sobre a face do abismo.</sys:String>
    <sys:String x:Key="Preview_Before">Texto antes</sys:String>
    <sys:String x:Key="Preview_Styled">texto com estilo</sys:String>
    <sys:String x:Key="Preview_After">e texto depois.</sys:String>
    <sys:String x:Key="Preview_Milestone">Um marco não tem texto para mostrar.</sys:String>
    <sys:String x:Key="Preview_Removed">Este marcador foi removido da folha de estilos.</sys:String>

    <!-- Warnings -->
    <sys:String x:Key="Warn_Duplicate">\Marker {0} aparece {1} vezes. O Paratext informa uma definição de estilo duplicada.</sys:String>
    <sys:String x:Key="Warn_DuplicateAttr">\{0} é definido mais de uma vez nesta entrada (linhas {1}). O Paratext usa a última e informa uma duplicata.</sys:String>
    <sys:String x:Key="Warn_DashName">\Marker {0} define um marcador novo chamado "{0}". Para remover \{1}, escreva \Marker {1} - (com um espaço).</sys:String>
    <sys:String x:Key="Warn_Stray">A linha {0} não está comentada, mas a linha \Marker acima dela está, então o Paratext aplica a linha ao marcador anterior.</sys:String>
    <sys:String x:Key="Warn_NeedsName">Um marcador novo precisa de \Name e \StyleType; caso contrário, o Paratext informa um erro.</sys:String>
    <sys:String x:Key="Warn_UnknownMarkers">Não estão na folha de estilos: {0}</sys:String>
    <sys:String x:Key="Warn_UnknownWords">Não são válidos aqui: {0}</sys:String>
    <sys:String x:Key="Warn_Invalid">"{0}" não é um valor válido para \{1}.</sys:String>
    <sys:String x:Key="Warn_Orphans">O Paratext ignora {0} linha(s) antes do primeiro \Marker.</sys:String>

    <!-- Status bar / app -->
    <sys:String x:Key="App_Title">Editor de folha de estilos personalizada</sys:String>
    <sys:String x:Key="Status_Unsaved">(não salvo)</sys:String>
    <sys:String x:Key="Status_SummaryFormat">{0} marcadores no arquivo</sys:String>
    <sys:String x:Key="Status_WarningsFormat">{0} para verificar</sys:String>
    <sys:String x:Key="Status_Saved">Salvo.</sys:String>

