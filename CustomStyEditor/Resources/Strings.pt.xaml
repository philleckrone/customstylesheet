    <sys:String x:Key="Check_TitleOccursUnder">Onde \{0} pode ocorrer</sys:String>
    <sys:String x:Key="Check_TitleTextProperties">Propriedades do texto de \{0}</sys:String>
    <sys:String x:Key="Check_CopyStock">Copiar lista padrão</sys:String>
    <sys:String x:Key="Check_Clear">Limpar</sys:String>
    <sys:String x:Key="Check_Nest">NEST: pode ser aninhado em outro estilo de caractere</sys:String>
    <sys:String x:Key="Check_Unknown">(não está na folha de estilos)</sys:String>

</ResourceDictionary>
