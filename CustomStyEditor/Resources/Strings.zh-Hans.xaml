<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Menu -->
    <sys:String x:Key="Menu_File">文件(_F)</sys:String>
    <sys:String x:Key="Menu_New">新建(_N)</sys:String>
    <sys:String x:Key="Menu_Open">打开(_O)…</sys:String>
    <sys:String x:Key="Menu_Save">保存(_S)</sys:String>
    <sys:String x:Key="Menu_SaveAs">另存为(_A)…</sys:String>
    <sys:String x:Key="Menu_Exit">退出(_X)</sys:String>

    <!-- Toolbar / project bar / banner -->
    <sys:String x:Key="Toolbar_Language">语言：</sys:String>
    <sys:String x:Key="ProjectBar_Format">项目：{0}</sys:String>
    <sys:String x:Key="ProjectBar_Base">基础样式表：{0}</sys:String>
    <sys:String x:Key="ProjectBar_BaseMissing">找不到基础样式表 {0}，因此无法显示标准值和标记列表。</sys:String>
    <sys:String x:Key="Banner_Reminder">Paratext 只在启动时读取 custom.sty：保存后，请关闭 Paratext 并重新打开，才能看到更改。</sys:String>

    <!-- Marker list -->
    <sys:String x:Key="Column_Disabled">停用</sys:String>
    <sys:String x:Key="Column_Marker">标记</sys:String>
    <sys:String x:Key="Column_Name">名称</sys:String>
    <sys:String x:Key="Column_Changes">更改</sys:String>
    <sys:String x:Key="Column_Status">状态</sys:String>
    <sys:String x:Key="Tip_DisabledColumn">勾选：整个条目用 # 注释掉，Paratext 会忽略它。</sys:String>
    <sys:String x:Key="Btn_AddStock">添加标准标记…</sys:String>
    <sys:String x:Key="Btn_NewMarker">新建标记…</sys:String>
    <sys:String x:Key="Btn_Remove">从样式表中移除</sys:String>
    <sys:String x:Key="Btn_Restore">恢复标记</sys:String>
    <sys:String x:Key="Btn_Delete">删除</sys:String>
    <sys:String x:Key="Tip_AddStock">自定义基础样式表中的标记。</sys:String>
    <sys:String x:Key="Tip_NewMarker">定义基础样式表中没有的标记。它会添加到 custom.sty 的末尾。</sys:String>
    <sys:String x:Key="Tip_Remove">写入 \Marker 名称 -，使 Paratext 不再提供该标记。</sys:String>
    <sys:String x:Key="Tip_Delete">从 custom.sty 删除此条目的所有行；标记恢复为标准样式。</sys:String>
    <sys:String x:Key="Status_New">新</sys:String>
    <sys:String x:Key="Status_Removed">已移除</sys:String>
    <sys:String x:Key="Status_Disabled">已注释</sys:String>
    <sys:String x:Key="Status_Warning">⚠ 请检查</sys:String>

    <!-- Property panel -->
    <sys:String x:Key="Panel_Empty">请在左侧选择一个标记，或用列表下方的按钮添加标记。</sys:String>
    <sys:String x:Key="Panel_DisabledNote">此条目已用 # 注释掉，Paratext 会忽略它。在列表中取消勾选“停用”即可编辑。</sys:String>
    <sys:String x:Key="Panel_RemovedNote">\Marker {0} - 会从项目的样式表中移除此标记。选择“恢复标记”可再次使用。</sys:String>
    <sys:String x:Key="Panel_NewNote">\{0} 不在基础样式表中：这是一个新标记。</sys:String>
    <sys:String x:Key="Group_Identity">名称和类型</sys:String>
    <sys:String x:Key="Group_TextFormat">文本格式</sys:String>
    <sys:String x:Key="Group_Font">字体和颜色</sys:String>
    <sys:String x:Key="Group_Paragraph">段落</sys:String>
    <sys:String x:Key="Group_Placement">可出现的位置</sys:String>
    <sys:String x:Key="Group_Other">其他</sys:String>
    <sys:String x:Key="Group_OtherLines">此条目中的其他行</sys:String>
    <sys:String x:Key="Tip_LineEnabled">勾选：Paratext 使用此行。不勾选：此行用 # 注释掉。</sys:String>
    <sys:String x:Key="Tip_Clear">从 custom.sty 删除此行（恢复标准值）。</sys:String>
    <sys:String x:Key="Row_Stock">{0}：{1}</sys:String>
    <sys:String x:Key="Row_NotSet">（未设置）</sys:String>
    <sys:String x:Key="Row_Overridden">第 {0} 行也设置了此项。Paratext 使用最后一行并报告重复。</sys:String>
    <sys:String x:Key="Flag_NotSet">（未设置）</sys:String>
    <sys:String x:Key="Flag_On">是</sys:String>
    <sys:String x:Key="Flag_Off">否 (\{0} -)</sys:String>
    <sys:String x:Key="Flag_StockOn">是</sys:String>
    <sys:String x:Key="Flag_StockOff">否</sys:String>
    <sys:String x:Key="Color_Pick">选择颜色…</sys:String>
    <sys:String x:Key="Color_NamesLabel">Paratext 颜色名称：</sys:String>
    <sys:String x:Key="Color_UnknownName">（未知的颜色名称）</sys:String>
    <sys:String x:Key="Btn_Choose">选择…</sys:String>
    <sys:String x:Key="Unit_Points">磅</sys:String>
    <sys:String x:Key="Unit_Inches">英寸</sys:String>
    <sys:String x:Key="Unit_LineSpacing">0 = 单倍，1 = 1.5 倍，2 = 双倍</sys:String>
    <sys:String x:Key="Note_TextProperties">Paratext 会把这些词加到基础样式表的文本属性中；custom.sty 无法移除任何属性。</sys:String>

    <!-- Keyword tooltips (from the Paratext help) -->
    <sys:String x:Key="KwTip_Name">在标记列表中显示的名称。必须唯一；可编辑它来翻译标记名称。</sys:String>
    <sys:String x:Key="KwTip_Description">描述该标记的注释。末尾加上 "(basic)" 会将其列入基本标记。</sys:String>
    <sys:String x:Key="KwTip_StyleType">Paragraph（段落）、Character（字符）、Note（注释）或 Milestone（里程碑）。</sys:String>
    <sys:String x:Key="KwTip_Endmarker">结束标记（如有），例如 f*。</sys:String>
    <sys:String x:Key="KwTip_TextType">文本种类：VerseText、Title、Section、NoteText、Other、BackTranslation……</sys:String>
    <sys:String x:Key="KwTip_TextProperties">例如 paragraph、publishable、vernacular、poetic、level_1 等属性。</sys:String>
    <sys:String x:Key="KwTip_Bold">文本为粗体。</sys:String>
    <sys:String x:Key="KwTip_Italic">文本为斜体。</sys:String>
    <sys:String x:Key="KwTip_Underline">文本带下划线。</sys:String>
    <sys:String x:Key="KwTip_Smallcaps">文本以小型大写字母显示。</sys:String>
    <sys:String x:Key="KwTip_Superscript">文本上标。</sys:String>
    <sys:String x:Key="KwTip_Subscript">文本下标。</sys:String>
    <sys:String x:Key="KwTip_Regular">关闭粗体、斜体和上标。</sys:String>
    <sys:String x:Key="KwTip_Fontname">此标记的字体。若不设置，则使用项目字体。</sys:String>
    <sys:String x:Key="KwTip_FontSize">字号（磅），相对于 12（项目的字号设置会使其偏移）。</sys:String>
    <sys:String x:Key="KwTip_Color">文本颜色：Paratext 颜色名称（适合低视力或色盲用户）或精确颜色。</sys:String>
    <sys:String x:Key="KwTip_Justification">Left（左）、Center（居中）、Right（右）或 Both（两端对齐）。</sys:String>
    <sys:String x:Key="KwTip_LeftMargin">整个段落的缩进（英寸）。</sys:String>
    <sys:String x:Key="KwTip_RightMargin">段落的右缩进（英寸）。</sys:String>
    <sys:String x:Key="KwTip_FirstLineIndent">首行的额外缩进（英寸），负数表示悬挂缩进。</sys:String>
    <sys:String x:Key="KwTip_SpaceBefore">段前额外间距（磅）。</sys:String>
    <sys:String x:Key="KwTip_SpaceAfter">段后额外间距（磅）。</sys:String>
    <sys:String x:Key="KwTip_LineSpacing">行间额外间距：0 = 单倍，1 = 1.5 倍，2 = 双倍。</sys:String>
    <sys:String x:Key="KwTip_OccursUnder">此标记可出现在其下的标记，用空格分隔。NEST 允许字符样式嵌套在另一个字符样式中。</sys:String>
    <sys:String x:Key="KwTip_Rank">与 OccursUnder 一起使用，指定同一父标记下各标记的顺序。</sys:String>
    <sys:String x:Key="KwTip_NotRepeatable">该标记不得在其父标记下重复出现。</sys:String>
    <sys:String x:Key="KwTip_Attributes">该标记接受的 USFM 3 属性（? = 可选）。</sys:String>

    <!-- Preview / file text -->
    <sys:String x:Key="Preview_Title">预览（近似）</sys:String>
    <sys:String x:Key="FileText_Title">custom.sty 中的行</sys:String>
    <sys:String x:Key="Preview_Sample">起初，神创造天地。地是空虚混沌，渊面黑暗。</sys:String>
    <sys:String x:Key="Preview_Before">前面的文本</sys:String>
    <sys:String x:Key="Preview_Styled">带样式的文本</sys:String>
    <sys:String x:Key="Preview_After">和后面的文本。</sys:String>
    <sys:String x:Key="Preview_Milestone">里程碑没有可预览的文本。</sys:String>
    <sys:String x:Key="Preview_Removed">此标记已从样式表中移除。</sys:String>

    <!-- Warnings -->
    <sys:String x:Key="Warn_Duplicate">\Marker {0} 出现了 {1} 次。Paratext 会报告样式定义重复。</sys:String>
    <sys:String x:Key="Warn_DuplicateAttr">此条目中 \{0} 设置了不止一次（第 {1} 行）。Paratext 使用最后一个并报告重复。</sys:String>
    <sys:String x:Key="Warn_DashName">\Marker {0} 定义了一个名为“{0}”的新标记。若要移除 \{1}，请写 \Marker {1} -（中间有空格）。</sys:String>
    <sys:String x:Key="Warn_Stray">第 {0} 行没有被注释，但它上方的 \Marker 行被注释了，因此 Paratext 把此行应用到前一个标记。</sys:String>
    <sys:String x:Key="Warn_NeedsName">新标记需要 \Name 和 \StyleType，否则 Paratext 会报告错误。</sys:String>
    <sys:String x:Key="Warn_UnknownMarkers">不在样式表中：{0}</sys:String>
    <sys:String x:Key="Warn_UnknownWords">此处无效：{0}</sys:String>
    <sys:String x:Key="Warn_Invalid">“{0}”不是 \{1} 的有效值。</sys:String>
    <sys:String x:Key="Warn_Orphans">第一个 \Marker 之前的 {0} 行会被 Paratext 忽略。</sys:String>

    <!-- Status bar / app -->
    <sys:String x:Key="App_Title">自定义样式表编辑器</sys:String>
    <sys:String x:Key="Status_Unsaved">（未保存）</sys:String>
    <sys:String x:Key="Status_SummaryFormat">文件中有 {0} 个标记</sys:String>
    <sys:String x:Key="Status_WarningsFormat">{0} 个需检查</sys:String>
    <sys:String x:Key="Status_Saved">已保存。</sys:String>

    <!-- Dialogs -->
    <sys:String x:Key="Btn_OK">确定</sys:String>
    <sys:String x:Key="Btn_Cancel">取消</sys:String>
    <sys:String x:Key="Dlg_SaveErrorTitle">保存错误</sys:String>
    <sys:String x:Key="Dlg_SaveErrorBody">无法保存文件：</sys:String>
    <sys:String x:Key="Dlg_OpenErrorTitle">打开错误</sys:String>
    <sys:String x:Key="Dlg_OpenErrorBody">无法打开文件：</sys:String>
    <sys:String x:Key="Dlg_UnsavedTitle">未保存的更改</sys:String>
    <sys:String x:Key="Dlg_UnsavedBody">有未保存的更改。是否在继续之前保存？</sys:String>
    <sys:String x:Key="Dlg_OpenTitle">打开样式表</sys:String>
    <sys:String x:Key="Dlg_SaveTitle">保存样式表</sys:String>
    <sys:String x:Key="Dlg_FileFilter">样式表 (*.sty)|*.sty|所有文件 (*.*)|*.*</sys:String>
    <sys:String x:Key="Dlg_DeleteTitle">删除条目</sys:String>
    <sys:String x:Key="Dlg_DeleteBody">从 custom.sty 删除 \{0} 的所有行吗？</sys:String>
    <sys:String x:Key="Picker_Title">添加标准标记</sys:String>
    <sys:String x:Key="Picker_Filter">查找：</sys:String>
    <sys:String x:Key="Picker_InFile">（已在 custom.sty 中）</sys:String>
    <sys:String x:Key="Picker_NoBase">找不到基础样式表，因此没有标准标记列表。</sys:String>
    <sys:String x:Key="New_Title">新建标记</sys:String>
    <sys:String x:Key="New_Marker">标记（不含 \）：</sys:String>
    <sys:String x:Key="New_Name">名称：</sys:String>
    <sys:String x:Key="New_StyleType">样式类型：</sys:String>
    <sys:String x:Key="New_Endmarker">结束标记：</sys:String>
    <sys:String x:Key="New_TextType">文本类型：</sys:String>
    <sys:String x:Key="New_TextProperties">文本属性：</sys:String>
    <sys:String x:Key="New_ErrEmpty">请输入不含反斜杠的标记，例如 zabc。</sys:String>
    <sys:String x:Key="New_ErrChars">标记不能包含空格、反斜杠、# 或 *。</sys:String>
    <sys:String x:Key="New_ErrStock">\{0} 在基础样式表中。请改用“添加标准标记”。</sys:String>
    <sys:String x:Key="New_ErrExists">\{0} 已在 custom.sty 中。</sys:String>
    <sys:String x:Key="New_ErrName">必须填写名称。</sys:String>
    <sys:String x:Key="New_WarnZ">USFM 把以 z 开头的标记留作项目专用。仍要添加 \{0} 吗？</sys:String>
    <sys:String x:Key="Check_TitleOccursUnder">\{0} 可出现的位置</sys:String>
    <sys:String x:Key="Check_TitleTextProperties">\{0} 的文本属性</sys:String>
    <sys:String x:Key="Check_CopyStock">复制标准列表</sys:String>
    <sys:String x:Key="Check_Clear">清除</sys:String>
    <sys:String x:Key="Check_Nest">NEST：可嵌套在另一个字符样式中</sys:String>
    <sys:String x:Key="Check_Unknown">（不在样式表中）</sys:String>

</ResourceDictionary>
